{
  "name": "fguillot/json-rpc",
  "description": "Simple JSON-RPC client/server library that just works",
  "homepage": "https://github.com/matasarei/json-rpc",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Frédéric Guillot"
    }
  ],
  "require": {
    "php": ">=8.4",
    "psr/log": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "squizlabs/php_codesniffer": "^3.13",
    "phpstan/phpstan": "^2.1",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.1",
    "psr/http-message": "^2.0",
    "nyholm/psr7": "^1.8"
  },
  "suggest": {
    "psr/http-client": "To send requests with any PSR-18 HTTP client (e.g. symfony/http-client) through Psr18Transport",
    "psr/http-factory": "PSR-17 factories required by Psr18Transport"
  },
  "autoload": {
    "psr-4": {
      "JsonRPC\\": "src/JsonRPC/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "JsonRPC\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "lint": "phpcs",
    "stan": "phpstan analyse --no-progress",
    "test": "phpunit",
    "coverage": [
      "phpunit --coverage-clover build/clover.xml",
      "php scripts/check-coverage.php build/clover.xml"
    ],
    "check": [
      "@lint",
      "@stan",
      "@test"
    ]
  },
  "config": {
    "sort-packages": true
  },
  "extra": {
    "branch-alias": {
      "dev-master": "2.x-dev"
    }
  }
}
