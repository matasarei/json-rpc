{
  "name": "fguillot/json-rpc",
  "description": "Simple JSON-RPC client/server library that just works",
  "homepage": "https://github.com/matasarei/json-rpc",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Frédéric Guillot"
    }
  ],
  "require": {
    "php": ">=8.0",
    "ext-json": "*",
    "psr/log": "^1.1 || ^2.0 || ^3.0"
  },
  "autoload": {
    "psr-4": {
      "JsonRPC\\": "src/JsonRPC/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.9",
    "phpstan/phpstan": "^2.1"
  }
}
